<%
  var allTags = [];
  site.tags.forEach(function (tag) { allTags.push(tag.name); });
  allTags.sort();
%>
<div class="container">
  <header class="page-head">
    <h1 class="page-title">Posts</h1>
    <% if (allTags.length > 0) { %>
    <div class="chips" role="group" aria-label="Filter by tag">
      <button class="chip is-active" type="button" data-tag="">All</button>
      <% allTags.forEach(function (tag) { %>
      <button class="chip" type="button" data-tag="<%= tag %>"><%- tag %></button>
      <% }) %>
    </div>
    <% } %>
  </header>

  <%- partial('partial/post-list', {posts: page.posts}) %>
  <p class="empty" id="tagNoResults" hidden>No posts with these tags.</p>

  <div id="paginationWrapper">
    <%- partial('partial/pagination') %>
  </div>
</div>

<script>
(function () {
  var selected = new Set();
  var chips = document.querySelectorAll('.chip');
  var rows = document.querySelectorAll('#postList li');
  var noResults = document.getElementById('tagNoResults');
  var pagination = document.getElementById('paginationWrapper');

  function filterPosts() {
    var visible = 0;
    rows.forEach(function (row) {
      var tags = JSON.parse(row.getAttribute('data-tags'));
      var match = selected.size === 0 || tags.some(function (t) { return selected.has(t); });
      row.hidden = !match;
      if (match) visible++;
    });
    chips.forEach(function (c) {
      var tag = c.getAttribute('data-tag');
      c.classList.toggle('is-active', tag ? selected.has(tag) : selected.size === 0);
    });
    noResults.hidden = visible > 0;
    pagination.hidden = selected.size > 0;
  }

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var tag = this.getAttribute('data-tag');
      if (!tag) selected.clear();
      else if (selected.has(tag)) selected.delete(tag);
      else selected.add(tag);
      filterPosts();
    });
  });
})();
</script>
