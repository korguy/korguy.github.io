<article class="container">
  <header class="page-head">
    <h1 class="page-title"><%- page.title %></h1>
    <div class="page-meta">
      <time datetime="<%= date_xml(page.date) %>"><%= full_date(page.date, 'll') %></time>
      <% if (page.tags && page.tags.length) { page.tags.each(function (tag) { %>
      <a href="<%- url_for(tag.path) %>"><%- tag.name %></a>
      <% }) } %>
    </div>
  </header>

  <div class="prose">
    <%- page.content %>
  </div>

  <%- partial('partial/comments') %>
</article>
