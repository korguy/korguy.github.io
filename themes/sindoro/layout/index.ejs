<div class="home container">
  <div class="home-text">
    <p class="home-greet" aria-hidden="true"><span id="typed"></span></p>
    <h1 class="home-name"><span>Hyun</span> <span>Kang</span></h1>
    <p class="home-lede">
      This is my archive for <a href="<%- url_for('/archives') %>">thoughts</a> and <a href="<%- url_for('/work') %>">works</a>.
    </p>
    <ul class="home-links">
      <li><a href="<%- theme.github %>" target="_blank" rel="noreferrer">GitHub</a></li>
      <li><a href="<%- theme.linkedin %>" target="_blank" rel="noreferrer">LinkedIn</a></li>
      <li><a href="<%- theme.google %>" target="_blank" rel="noreferrer">Google Scholar</a></li>
      <li><a href="/file/CV_Hyun_Kang.pdf" target="_blank" rel="noreferrer">CV</a></li>
    </ul>
  </div>

  <div class="home-stage">
    <div class="home-orb" aria-hidden="true"></div>
    <div class="home-now glass">
      <p class="home-now-label">Currently</p>
      <p class="home-now-role">Machine learning engineer at <a href="https://www.clovirtualfashion.com/" target="_blank" rel="noreferrer">CLO Virtual Fashion</a></p>
    </div>
  </div>
</div>

<script>
  // The orb leans toward the pointer, so the glass card above it refracts a moving edge.
  (function () {
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var stage = document.querySelector('.home-stage');
    var orb = document.querySelector('.home-orb');
    addEventListener('pointermove', function (e) {
      var r = stage.getBoundingClientRect();
      var dx = (e.clientX - (r.left + r.width / 2)) / innerWidth;
      var dy = (e.clientY - (r.top + r.height / 2)) / innerHeight;
      orb.style.setProperty('--ox', (Math.max(-1, Math.min(1, dx)) * 2.5).toFixed(3) + 'rem');
      orb.style.setProperty('--oy', (Math.max(-1, Math.min(1, dy)) * 2.5).toFixed(3) + 'rem');
    });
  })();
</script>
<script src="https://cdn.jsdelivr.net/npm/typed.js@2.0.11"></script>
<script>
  new Typed('#typed', {
    strings: ['Hello!^700', '안녕하세요!^700'],
    typeSpeed: 50,
    smartBackspace: true,
    backSpeed: 40,
    loop: true,
  });
</script>
