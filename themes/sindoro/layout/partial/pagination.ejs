<% if (page.prev || page.next) { %>
<nav class="pagination" aria-label="Pagination">
  <% if (page.prev) { %>
  <a href="<%- url_for(page.prev_link) %>">Newer posts</a>
  <% } else { %><span></span><% } %>
  <% if (page.next) { %>
  <a href="<%- url_for(page.next_link) %>">Older posts</a>
  <% } %>
</nav>
<% } %>
